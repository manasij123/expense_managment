<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header row: title + profile / sign-in -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gas_alarm_title_bar"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:gravity="end"
                android:layout_marginEnd="8dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_in_with_google"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/rose"
            android:background="@drawable/btn_outline_rose"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Clock hero card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/card_bg"
            android:elevation="3dp"
            android:layout_marginBottom="20dp">

            <com.expensemanagement.app.AnalogClockView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="12dp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm:ss a"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- Gas alarm card: one daily check-in time -->
        <LinearLayout
            android:id="@+id/cardGasAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_rose"
            android:elevation="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gas_alarm_label"
                android:textSize="12sp"
                android:textColor="@color/rose"
                android:letterSpacing="0.05"
                android:textAllCaps="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:id="@+id/gasAlarmRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_tint_bg"
                        android:backgroundTint="@color/rose_soft" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_alarm"
                        android:tint="@color/rose" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gas_check_time_label"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/gasAlarmTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gas_alarm_hint"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />

        </LinearLayout>

        <!-- Action row: tone + test -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/cardSelectTone"
                style="@style/ActionCardInner"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/action_card_glow_green"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <FrameLayout style="@style/ActionCardIconFrame">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/circle_tint_bg" android:backgroundTint="@color/brand_green_soft" />
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                        android:src="@drawable/ic_music_note" android:tint="@color/brand_green" />
                </FrameLayout>
                <TextView
                    android:id="@+id/toneLabel"
                    style="@style/ActionCardLabel"
                    android:text="@string/select_alarm_tone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTestAlarm"
                style="@style/ActionCardInner"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/action_card_glow_indigo"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <FrameLayout style="@style/ActionCardIconFrame">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/circle_tint_bg" android:backgroundTint="@color/brand_indigo_soft" />
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                        android:src="@drawable/ic_play_circle" android:tint="@color/brand_indigo" />
                </FrameLayout>
                <TextView
                    style="@style/ActionCardLabel"
                    android:text="@string/test_alarm_short" />
            </LinearLayout>

        </LinearLayout>

        <!-- Permissions banner -->
        <LinearLayout
            android:id="@+id/cardPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_bg_rose"
            android:elevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_shield_check"
                    android:tint="@color/rose"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_needed"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/rose" />

            </LinearLayout>

            <Button
                android:id="@+id/btnGrantExactAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_exact_alarm"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/rose"
                android:background="@drawable/btn_outline_rose"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGrantFullScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_full_screen"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/rose"
                android:background="@drawable/btn_outline_rose"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
